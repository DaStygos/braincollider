# Required outside local development.
DJANGO_SECRET_KEY=replace-with-a-long-random-value

# Set to false for deployment.
DEBUG=false

# Comma-separated hostnames, without schemes.
ALLOWED_HOSTS=example.com,www.example.com

# Comma-separated origins, including the scheme.
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Enable when HTTPS is terminated by the application or reverse proxy.
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000